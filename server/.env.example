# ---------- runtime ----------
NODE_ENV=development
PORT=4000
APP_NAME=CareerForge
APP_URL=http://localhost:5173
API_URL=http://localhost:4000

# ---------- database (MySQL / MariaDB) ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=careerforge
DB_PASSWORD=change-me
DB_NAME=careerforge

# ---------- auth ----------
# generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-64-random-hex-chars
JWT_REFRESH_SECRET=replace-with-another-64-random-hex-chars
ACCESS_TOKEN_TTL=30m
REFRESH_TOKEN_TTL_DAYS=30

# ---------- OTP policy ----------
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_PER_EMAIL_PER_HOUR=5
# Per IP per 15 minutes. Keep these at the defaults in production;
# raise OTP_MAX_REQUESTS_PER_IP locally if the test suites trip it.
OTP_MAX_REQUESTS_PER_IP=10
OTP_MAX_VERIFIES_PER_IP=30

# ---------- email (SMTP) ----------
# Full guide, including what to ask KLU IT for: docs/EMAIL-SETUP.md
# Test any of these with:  node server/src/db/test-mail.js you@example.com
#
# A) KL University / Microsoft 365
#    NOTE: Microsoft disabled basic SMTP auth tenant-wide. A correct password
#    still fails with 535 until IT enables "Authenticated SMTP" on the mailbox.
#      SMTP_HOST=smtp.office365.com
#      SMTP_PORT=587
#      SMTP_SECURE=false
#
# B) Transactional provider — recommended for 650+ students
#      SMTP_HOST=smtp-relay.brevo.com     (or smtp.resend.com)
#      SMTP_PORT=587
#      SMTP_SECURE=false
#
# C) Hostinger mailbox (created in hPanel)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=your-mailbox-password
MAIL_FROM_NAME=CareerForge
# must equal SMTP_USER, or an alias that mailbox owns
MAIL_FROM_ADDRESS=no-reply@yourdomain.com

# When true (and NODE_ENV!=production) OTPs are printed to the server log
# and returned in the API response so you can test without a mailbox.
MAIL_DEV_ECHO=true

# ---------- email validation ----------
# verify the domain actually has MX records before accepting a signup
VALIDATE_EMAIL_MX=true
# comma separated; empty = allow any domain. e.g. klu.ac.in,kluniversity.in
ALLOWED_EMAIL_DOMAINS=

# ---------- AI writing help (optional) ----------
# Key from https://aistudio.google.com/apikey . Without it the AI endpoints
# decline politely and nothing else changes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ---------- rate limits ----------
# Per IP per minute. Generous enough for the resume builder's autosave;
# the OTP endpoints have their own, much tighter limits above.
RATE_LIMIT_API_PER_MIN=300
RATE_LIMIT_WRITES_PER_MIN=240

# ---------- job alerts ----------
# node-cron expression, server local time
JOB_ALERT_CRON=0 8 * * *
TZ=Asia/Kolkata
