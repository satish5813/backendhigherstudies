# Serves the built app and forwards the API to the backend, so the browser sees
# a single origin. ${API_UPSTREAM} is substituted from the environment when the
# container starts; everything else with a $ is nginx's own.

server {
  listen 80;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml;
  gzip_min_length 1024;

  # Application-proof screenshots are up to 8 MB; the roster import is ~1.3 MB.
  client_max_body_size 20m;

  # Hashed build assets never change. index.html must never be cached, or a
  # browser keeps asking for chunk names that no longer exist after a deploy.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location = /index.html {
    add_header Cache-Control "no-cache, must-revalidate";
  }

  location /api/ {
    proxy_pass https://${API_UPSTREAM};
    proxy_ssl_server_name on;
    proxy_set_header Host ${API_UPSTREAM};
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 120s;
  }

  # Profile photos are written by the backend and served from it.
  location /uploads/ {
    proxy_pass https://${API_UPSTREAM};
    proxy_ssl_server_name on;
    proxy_set_header Host ${API_UPSTREAM};
  }

  # Everything else is a client-side route.
  location / {
    try_files $uri /index.html;
  }
}
