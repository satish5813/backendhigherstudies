{
  "name": "careerforge",
  "private": true,
  "version": "1.0.0",
  "description": "CareerForge — student profiling + ATS resume builder + daily job alerts",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "migrate": "npm --workspace server run migrate",
    "seed": "npm --workspace server run seed",
    "start": "npm --workspace server run start",
    "push:client": "node scripts/push-client.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
